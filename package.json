{
  "name": "tldw",
  "version": "0.4.0",
  "description": "Browser extension that turns web videos — YouTube, Vimeo, or any native HTML5 video — into structured Markdown summaries, even behind a login. Your own API keys, no backend.",
  "license": "MIT",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:test": "node scripts/build-test.mjs",
    "preview": "vite preview",
    "predev": "node scripts/copy-ffmpeg.mjs",
    "prebuild": "node scripts/copy-ffmpeg.mjs",
    "ffmpeg": "node scripts/copy-ffmpeg.mjs",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "icons": "node scripts/gen-icons.mjs",
    "package": "node scripts/package.mjs",
    "release:check": "node scripts/release-check.mjs",
    "share": "node scripts/share.mjs",
    "share:lite": "node scripts/share.mjs --lite",
    "test:e2e": "node e2e/run.mjs --build",
    "test:e2e:pipeline": "node e2e/pipeline.mjs --build",
    "perf:e2e": "node e2e/perf.mjs",
    "e2e:install": "playwright install chromium"
  },
  "dependencies": {
    "@ffmpeg/core": "^0.12.10",
    "@ffmpeg/ffmpeg": "^0.12.15",
    "@ffmpeg/util": "^0.12.2",
    "docx": "^9.11.0",
    "jspdf": "^2.5.2",
    "preact": "^10.24.3"
  },
  "devDependencies": {
    "@crxjs/vite-plugin": "^2.0.0-beta.28",
    "@preact/preset-vite": "^2.9.1",
    "@resvg/resvg-js": "^2.6.2",
    "@types/chrome": "^0.0.279",
    "@types/node": "^20.19.43",
    "@typescript-eslint/eslint-plugin": "^8.13.0",
    "@typescript-eslint/parser": "^8.13.0",
    "eslint": "^8.57.1",
    "playwright": "1.64.1",
    "prettier": "^3.3.3",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vitest": "^2.1.5"
  }
}
