{
  "name": "tldw",
  "version": "0.1.0",
  "description": "Browser extension that turns embedded YouTube and Vimeo videos into structured Markdown summaries — even behind authentication.",
  "license": "MIT",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "predev": "node scripts/copy-ffmpeg.mjs",
    "prebuild": "node scripts/copy-ffmpeg.mjs",
    "ffmpeg": "node scripts/copy-ffmpeg.mjs",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "icons": "node scripts/gen-icons.mjs"
  },
  "dependencies": {
    "@ffmpeg/core": "^0.12.10",
    "@ffmpeg/ffmpeg": "^0.12.15",
    "@ffmpeg/util": "^0.12.2",
    "preact": "^10.24.3"
  },
  "devDependencies": {
    "@crxjs/vite-plugin": "^2.0.0-beta.28",
    "@preact/preset-vite": "^2.9.1",
    "@types/chrome": "^0.0.279",
    "@types/node": "^20.19.43",
    "@typescript-eslint/eslint-plugin": "^8.13.0",
    "@typescript-eslint/parser": "^8.13.0",
    "eslint": "^8.57.1",
    "prettier": "^3.3.3",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vitest": "^2.1.5"
  }
}
